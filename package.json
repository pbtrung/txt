{
  "name": "txt",
  "version": "0.9999",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "tsc": "node node_modules/typescript7/bin/tsc",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:typecheck": "npm run tsc -- -b ui/tsconfig.json",
    "ui:build": "npm run tsc -- -b ui/tsconfig.json && vite build --config ui/vite.config.ts && rm -rf dist/test-* dist/sqlcipher.js.symbols dist/*.mjs dist/package.json ui/node_modules && cp ui/_headers dist/_headers",
    "ui:test": "vitest run --config ui/vite.config.ts",
    "worker:types": "wrangler types worker/worker-configuration.d.ts",
    "worker:dev": "npm run worker:types && wrangler dev",
    "worker:typecheck": "npm run worker:types && npm run tsc -- -p worker/tsconfig.json",
    "worker:test": "npm run worker:types && vitest run --config worker/vitest.config.ts",
    "deploy": "sh scripts/deploy.sh",
    "format": "prettier --write \"**/*.{ts,tsx,js}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js}\"",
    "lint": "eslint ui worker"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@likecoin/epub-ts": "^0.7.2",
    "@sentry/react": "^10.73.0",
    "aws4fetch": "^1.0.20",
    "brotli-wasm": "^3.0.1",
    "dompurify": "^3.4.14",
    "fuse.js": "^7.5.0",
    "jose": "^6.2.10",
    "jszip": "^3.10.1",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-aria": "^3.52.0",
    "react-aria-components": "^1.21.0",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260902.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "daisyui": "^5.7.25",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
