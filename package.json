{
  "name": "txt",
  "version": "0.9999",
  "private": true,
  "type": "module",
  "scripts": {
    "tsc": "node node_modules/typescript7/bin/tsc",
    "lua:format": "sh scripts/lua-tools.sh format",
    "lua:format:check": "sh scripts/lua-tools.sh format-check",
    "lua:lint": "sh scripts/lua-tools.sh lint",
    "lua:test": "sh scripts/lua-tools.sh test",
    "lua:check": "sh scripts/lua-tools.sh check",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:typecheck": "npm run tsc -- -b ui/tsconfig.json",
    "ui:build": "npm run tsc -- -b ui/tsconfig.json && vite build --config ui/vite.config.ts && rm -rf dist/test-* dist/sqlcipher.js.symbols dist/*.mjs dist/package.json ui/node_modules && cp ui/_headers dist/_headers",
    "ui:test": "vitest run --config ui/vite.config.ts",
    "deploy": "sh scripts/deploy.sh",
    "format": "prettier --write \"**/*.{ts,tsx,js}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js}\"",
    "lint": "eslint ui"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@likecoin/epub-ts": "^0.7.1",
    "@sentry/react": "^10.70.0",
    "aws4fetch": "^1.0.20",
    "brotli-wasm": "^3.0.1",
    "dompurify": "^3.4.13",
    "fuse.js": "^7.5.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@johnnymorganz/stylua-bin": "^2.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "daisyui": "^5.7.19",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
