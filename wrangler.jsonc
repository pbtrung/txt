{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "txt",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-21",
  // Custom domain in use instead -- add it as a "routes" entry (dashboard
  // or wrangler.jsonc) separately; that's independent of this flag.
  "workers_dev": false,
  // One Worker serves both /v1/* and the static UI (docs/deployment.md §1).
  // ASSETS is served by worker/index.ts explicitly delegating non-/v1/*
  // requests to it, not by Wrangler's default asset-first routing --
  // see worker/index.ts for why.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Non-secret, deployment-specific config (docs/auth.md §2). Real values
  // are never committed here, matching the R2 bucket_name pattern below --
  // scripts/deploy.sh substitutes them from a gitignored JSON config file
  // (creds/deploy.json by default, docs/deployment.md §2). The placeholders
  // work as-is for local `wrangler dev`/tests, which use their own fixed
  // test values (worker/vitest.config.ts).
  "vars": {
    "OWNER_EMAIL": "replace-me-owner-email",
    "CF_ACCESS_TEAM_DOMAIN": "replace-me-team-domain",
    "CF_ACCESS_AUD": "replace-me-access-aud",
    "CF_ACCOUNT_ID": "replace-me-account-id",
    // Same placeholder token as r2_buckets[0].bucket_name below --
    // deploy.sh's substitution is a plain literal replace, so one
    // BUCKET_NAME config value fills in both. This one is a
    // runtime-readable string the Worker's own code needs (to name the
    // bucket in R2 temp-access-credentials requests, docs/storage_layout.md
    // §"Credentials"); the binding's bucket_name is a separate, Wrangler-only
    // config field with no runtime string equivalent.
    "BUCKET_NAME": "replace-me-bucket-name",
    // TESTING ONLY, never "true" for a real deployment (docs/deployment.md
    // §2, worker/api.ts's accessCheckSkipped()) -- lets every non-public
    // /v1/* route through with no Access session, for exercising the app
    // before an Access application exists yet. deploy.sh only ever flips
    // this on when creds/deploy.json explicitly asks for it.
    "SKIP_ACCESS_CHECK": "false"
  },
  // The real database_id is never committed here -- scripts/deploy.sh
  // resolves or creates the production database (wrangler d1 list/create)
  // and substitutes its id, the same sed pattern as every other
  // "replace-me-*" placeholder; it also rewrites database_name to
  // "txt-production" in that same substitution, so a deploy's own
  // bindings summary names the database actually bound instead of this
  // local dev label. Local `wrangler dev`/tests don't need a real value
  // either: Miniflare's local D1 emulation uses this string only as an
  // opaque local cache key, not a real database lookup.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "txt-dev",
      "database_id": "replace-me-database-id",
      "migrations_dir": "worker/migrations"
    }
  ],
  // The real bucket name is never committed here -- scripts/deploy.sh
  // substitutes it from the required BUCKET_NAME config value (see "vars"
  // above) before deploying. The placeholder is left as-is for local
  // `wrangler dev`/tests: Miniflare's local R2 emulation doesn't validate
  // that a bucket by this name actually exists, so it works fine as a
  // local, harmless storage key.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "replace-me-bucket-name"
    }
  ]
}
