{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A placeholder, not the real name -- scripts/deploy.sh always overrides
  // this via `wrangler deploy --name "$WORKER_NAME"` (erroring out if
  // WORKER_NAME is unset/empty) so the actual deploy target never depends
  // on this file matching whatever Worker resource actually exists on
  // Cloudflare. Must still be a syntactically valid Worker name (lowercase,
  // alphanumeric + hyphens) for `wrangler` to parse this file at all.
  "name": "unused-placeholder-set-worker-name-via-env-var",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  // worker/index.ts is the real script this project was missing -- once
  // deployed, the dashboard's "Variables and secrets" page stops refusing
  // (that error only fires for a Worker that has assets but no script).
  "main": "worker/index.ts",
  "assets": {
    // ui:build's Vite step writes the deployed static site here (see
    // ui/vite.config.ts's build.outDir) -- unrelated to this file's own
    // bundling, which wrangler does separately via `main` above.
    "directory": "./dist",
    "binding": "ASSETS",
  },
  // No [vars] block here on purpose -- worker/r2Creds.ts's runtime values
  // (READ_WRITE_ACCESS_KEY_ID, READ_WRITE_SECRET_ACCESS_KEY, R2_BUCKET,
  // R2_ENDPOINT, INSTANT_APP_ID; see worker/env.d.ts) are configured as
  // Cloudflare dashboard Variables and Secrets instead of committed here. The
  // two access-key values are the admin's real R2 credential and must not be
  // in git; the non-secret vars live beside them so there is one deployment
  // configuration surface.
}
