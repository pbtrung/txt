{
  "rules": [
    {
      "allowed": {
        "origins": ["https://reader.example.com"],
        "methods": ["GET", "PUT"],
        "headers": [
          "Authorization",
          "Content-Type",
          "If-Match",
          "If-None-Match",
          "Range",
          "X-Amz-Content-Sha256",
          "X-Amz-Date",
          "X-Amz-Security-Token"
        ]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
